#
# Highstate target for each profile's project AppVM. Pass qubes, gpg qubes,
# and agent AppVMs that are not a profile are not targets. Apply one qube
# without enabling this top:
#
#   sudo qubesctl --skip-dom0 --targets=slchris-project state.apply secrets.apply

{%- from 'config.jinja' import cfg with context %}
base:
{% for name, profile in cfg.profiles.items() %}
  '{{ profile.project }}':
    - secrets.apply
{% endfor %}
