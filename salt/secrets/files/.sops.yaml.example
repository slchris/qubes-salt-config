# Copy to the root of the private repo as .sops.yaml.
# Recipients are public. Age is optional and stays commented until you
# generate a workstation recipient; never put an age private key here.
creation_rules:
  # One rule per profile. The fingerprint is that profile's encrypt subkey.
  - path_regex: secrets/profiles/slchris\.yaml$
    pgp: 47A2A768885CC8501DD1BB4F108477BC92020DB1
    # age: age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
  # - path_regex: secrets/profiles/other\.yaml$
  #   pgp: <that profile's encrypt subkey>
