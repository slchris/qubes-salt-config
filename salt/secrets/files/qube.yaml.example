# Plaintext shape of secrets/profiles/<profile>.yaml in the PRIVATE repo.
# Encrypt that copy with sops. Do not commit ciphertext or this filled in
# to qubes-salt-config. Placeholder values only.

files:
  - path: /home/user/.config/gh/hosts.yml
    mode: "0600"
    content: |
      github.com:
          user: example
          oauth_token: replace-me
  - path: /home/user/.kube/config
    mode: "0600"
    content: |
      apiVersion: v1
      kind: Config
      clusters: []
