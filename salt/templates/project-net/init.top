{% from 'config.jinja' import cfg with context %}
base:
  'dom0':
    - match: nodegroup
    - templates.project-net.create
  'tpl-project-net':
    - templates.project-net.install
{% for key in cfg.project_nets %}
  'sys-{{ key }}':
    - templates.project-net.configure
{% endfor %}
